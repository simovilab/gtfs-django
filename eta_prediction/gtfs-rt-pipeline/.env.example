# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# --- Database ---
DATABASE_URL=postgresql://gtfs:gtfs@postgres:5432/gtfs
# For host tooling outside Docker, override to postgresql://gtfs:gtfs@localhost:15432/gtfs

# --- Redis (Celery broker/backend) ---
REDIS_URL=redis://redis:6379/0
# For host tooling override to redis://localhost:16379/0

# --- GTFS-RT Feed Configuration ---
FEED_NAME=demo
GTFSRT_VEHICLE_POSITIONS_URL=https://cdn.mbta.com/realtime/VehiclePositions.pb
GTFSRT_TRIP_UPDATES_URL=https://cdn.mbta.com/realtime/TripUpdates.pb
POLL_SECONDS=5

# --- HTTP Client ---
HTTP_CONNECT_TIMEOUT=3
HTTP_READ_TIMEOUT=5

# --- S3 VehiclePosition sink (Hive-partitioned Parquet) ---
# Enable dual-write of parsed VPs to S3 alongside Postgres.
S3_VP_SINK_ENABLED=False
# Leave empty to use the default s3://transit/feeds/mbta/vehicle_positions
S3_VP_BASE_URI=
# S3/MinIO credentials (see SIMOVILAB-S3.md; never commit real values)
AWS_ENDPOINT_URL=https://data.simovilab.org
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Local spool (poll -> spool -> hourly S3 flush) ---
# Polls append here instead of writing to S3 directly; DuckDB is
# single-writer, so the poll queue must run at --concurrency=1.
SPOOL_PATH=/data/spool/vp_spool.duckdb

# --- Observability status files (atomic, cat/tail-able) ---
STATUS_DIR=/var/lib/simovi/status

# --- Hourly spool -> S3 staging flush ---
# One Parquet object per (year, month, day); no route_id partitioning here
# (that fan-out is what caused the incident this spool fixes).
S3_VP_STAGING_BASE_URI=s3://transit/feeds/mbta/vehicle_positions_staging
SPOOL_FLUSH_MINUTE=2

# --- Daily staging -> curated compaction ---
COMPACT_HOUR_UTC=3
COMPACT_MINUTE=15

# --- Weekly static GTFS snapshots (roadmap 0.2) ---
MBTA_GTFS_STATIC_URL=https://cdn.mbta.com/MBTA_GTFS.zip
BUCR_GTFS_STATIC_URL=https://feeds.simovi.org/bucr/schedule/gtfs.zip
STATIC_GTFS_SNAPSHOT_DOW=1
STATIC_GTFS_SNAPSHOT_HOUR_UTC=4
STATIC_GTFS_SNAPSHOT_MINUTE=0
